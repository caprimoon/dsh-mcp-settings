{
  "name": "@caprimoon/dsh-mcp-settings",
  "version": "1.1.0",
  "type": "module",
  "description": "MCP servers page in Settings for the DeepSeek Harness Web GUI: list, add, edit, enable, probe, restart and delete the servers of @deepseek-ai/dsh-mcp-manager, with every write persisted to the active profile patch.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "mcp",
    "mcp-server",
    "settings",
    "plugin",
    "bundle"
  ],
  "license": "MIT",
  "author": "caprimoon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caprimoon/dsh-mcp-settings.git"
  },
  "homepage": "https://github.com/caprimoon/dsh-mcp-settings#readme",
  "bugs": {
    "url": "https://github.com/caprimoon/dsh-mcp-settings/issues"
  }
}